/* Reset and Base Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Color Palette */
    --bg-primary: #0a0a0b;
    --bg-secondary: #1a1a1d;
    --bg-tertiary: #2a2a2f;
    --bg-card: #1e1e23;
    --border-color: #333338;
    --text-primary: #ffffff;
    --text-secondary: #b4b4b8;
    --text-muted: #808085;
    --accent-primary: #6366f1;
    --accent-secondary: #8b5cf6;
    --success: #10b981;
    --warning: #f59e0b;
    --error: #ef4444;
    --gradient-primary: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    --gradient-secondary: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    
    /* Spacing */
    --spacing-xs: 0.25rem;
    --spacing-sm: 0.5rem;
    --spacing-md: 1rem;
    --spacing-lg: 1.5rem;
    --spacing-xl: 2rem;
    --spacing-2xl: 3rem;
    --spacing-3xl: 4rem;
    
    /* Border Radius */
    --radius-sm: 0.375rem;
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-xl: 1rem;
    --radius-2xl: 1.5rem;
    
    /* Shadows */
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    
    /* Transitions */
    --transition-fast: 0.15s ease-in-out;
    --transition-normal: 0.3s ease-in-out;
    --transition-slow: 0.5s ease-in-out;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    min-height: 100vh;
    overflow-x: hidden;
}

/* App Container */
.app-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: radial-gradient(ellipse at top, rgba(99, 102, 241, 0.1) 0%, transparent 50%);
}

/* Header */
.app-header {
    padding: var(--spacing-xl) var(--spacing-lg);
    text-align: center;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
}

.header-content {
    max-width: 1200px;
    margin: 0 auto;
}

.app-title {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: var(--spacing-sm);
    letter-spacing: -0.025em;
}

.gradient-text {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.app-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-lg);
    font-weight: 400;
}

.model-info {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
}

.model-badge,
.backend-badge {
    padding: var(--spacing-xs) var(--spacing-md);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
}

/* Main Content */
.main-content {
    flex: 1;
    padding: var(--spacing-2xl) var(--spacing-lg);
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
}

/* App States */
.app-state {
    opacity: 1;
    transform: translateY(0);
    transition: all var(--transition-slow);
}

.app-state.transitioning-out {
    opacity: 0;
    transform: translateY(-20px);
}

.app-state.transitioning-in {
    opacity: 0;
    transform: translateY(20px);
}

/* STATE 1: Landing Page - Prominent Upload Section */
.upload-section-prominent {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    gap: var(--spacing-3xl);
}

.upload-area-prominent {
    border: 3px dashed var(--border-color);
    border-radius: var(--radius-2xl);
    padding: var(--spacing-3xl);
    text-align: center;
    background: var(--bg-card);
    transition: all var(--transition-normal);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    min-width: 600px;
    max-width: 800px;
    width: 100%;
}

.upload-area-prominent::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--transition-normal);
    z-index: 0;
}

.upload-area-prominent:hover {
    border-color: var(--accent-primary);
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
}

.upload-area-prominent:hover::before {
    opacity: 0.05;
}

.upload-area-prominent.drag-over {
    border-color: var(--accent-primary);
    background: rgba(99, 102, 241, 0.1);
    transform: scale(1.02);
}

.upload-area-prominent > * {
    position: relative;
    z-index: 1;
}

.upload-area-prominent .upload-icon {
    color: var(--accent-primary);
    margin-bottom: var(--spacing-xl);
}

.upload-area-prominent h2 {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    color: var(--text-primary);
}

.upload-area-prominent p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-xl);
}

.upload-button {
    background: none;
    border: none;
    color: var(--accent-primary);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    font-size: inherit;
    transition: color var(--transition-fast);
}

.upload-button:hover {
    color: var(--accent-secondary);
}

.upload-hints {
    display: flex;
    justify-content: center;
    gap: var(--spacing-xl);
    font-size: 1rem;
    color: var(--text-muted);
}

/* Upscale Options */
.upscale-options {
    text-align: center;
    width: 100%;
    max-width: 800px;
}

.upscale-options h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xl);
    color: var(--text-primary);
}

.scale-buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    max-width: 600px;
    margin: 0 auto;
}

.scale-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-xl) var(--spacing-lg);
    background: var(--bg-card);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-xl);
    cursor: pointer;
    transition: all var(--transition-normal);
    position: relative;
    overflow: hidden;
}

.scale-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--transition-normal);
    z-index: 0;
}

.scale-btn:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.scale-btn:hover::before {
    opacity: 0.1;
}

.scale-btn.active {
    border-color: var(--accent-primary);
    background: rgba(99, 102, 241, 0.1);
}

.scale-btn.active::before {
    opacity: 0.15;
}

.scale-btn > * {
    position: relative;
    z-index: 1;
}

.scale-factor {
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: var(--spacing-xs);
}

.scale-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 500;
}

/* STATE 2: Results View */
.results-view {
    width: 100%;
}

.results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--border-color);
}

.results-header h2 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-primary);
}

.new-image-btn {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-xl);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.new-image-btn:hover {
    background: var(--bg-card);
    border-color: var(--accent-primary);
    transform: translateY(-1px);
}

.results-comparison {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--spacing-2xl);
    align-items: start;
}

/* Image Panels */
.image-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--spacing-xl);
    box-shadow: var(--shadow-md);
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--border-color);
}

.panel-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
}

.scale-indicator {
    background: var(--gradient-primary);
    color: white;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
}

.image-container {
    margin-bottom: var(--spacing-lg);
    text-align: center;
    background: var(--bg-tertiary);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.image-container canvas {
    max-width: 100%;
    max-height: 400px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
}

.upscaled-panel .image-container {
    min-height: 400px;
}

.upscaled-panel .image-container canvas {
    max-height: 500px;
}

/* Image Metadata */
.image-metadata {
    margin-bottom: var(--spacing-lg);
}

.metadata-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.metadata-item:last-child {
    border-bottom: none;
}

.metadata-label {
    color: var(--text-secondary);
    font-weight: 500;
}

.metadata-value {
    color: var(--text-primary);
    font-weight: 600;
}

/* Action Buttons */
.action-buttons {
    display: flex;
    gap: var(--spacing-md);
}

.download-btn,
.save-btn {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-md);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    border: none;
    font-size: 0.875rem;
}

.download-btn.primary {
    background: var(--gradient-primary);
    color: white;
    box-shadow: var(--shadow-md);
    flex: 1;
}

.download-btn.primary:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-lg);
}

.save-btn.secondary {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    flex: 1;
}

.save-btn.secondary:hover {
    background: var(--bg-card);
    border-color: var(--accent-primary);
}

/* Progress Container */
.progress-container {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--spacing-xl);
    margin-top: var(--spacing-xl);
    box-shadow: var(--shadow-md);
}

.progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
}

.progress-header h3 {
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 600;
}

.progress-bar-container {
    background: var(--bg-tertiary);
    border-radius: var(--radius-lg);
    height: 8px;
    overflow: hidden;
    margin-bottom: var(--spacing-md);
}

#progress-bar {
    height: 100%;
    background: var(--gradient-primary);
    border-radius: var(--radius-lg);
    transition: width var(--transition-normal);
    width: 0%;
}

.progress-text {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

/* Legacy Upload Section (for compatibility) */
.upload-section {
    margin-bottom: var(--spacing-2xl);
}

.upload-area {
    border: 2px dashed var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    text-align: center;
    background: var(--bg-card);
    transition: all var(--transition-normal);
    cursor: pointer;
    position: relative;
    overflow: hidden;
}

.upload-area::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--transition-normal);
    z-index: 0;
}

.upload-area:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
}

.upload-area:hover::before {
    opacity: 0.05;
}

.upload-area.drag-over {
    border-color: var(--accent-primary);
    background: rgba(99, 102, 241, 0.1);
}

.upload-area > * {
    position: relative;
    z-index: 1;
}

.upload-icon {
    color: var(--accent-primary);
    margin-bottom: var(--spacing-lg);
}

.upload-area h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
    color: var(--text-primary);
}

.upload-area p {
    color: var(--text-secondary);
    margin-bottom: var(--spacing-lg);
}

/* Processing Section */
.processing-section {
    margin-bottom: var(--spacing-2xl);
}

.processing-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    text-align: center;
    box-shadow: var(--shadow-lg);
}

.processing-card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
    color: var(--text-primary);
}

.progress-container {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
}

.progress-bar {
    flex: 1;
    height: 8px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: relative;
}

.progress-fill {
    height: 100%;
    background: var(--gradient-primary);
    border-radius: var(--radius-sm);
    transition: width var(--transition-normal);
    width: 0%;
    position: relative;
}

.progress-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    animation: shimmer 2s infinite;
}

@keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

.progress-text {
    font-weight: 600;
    color: var(--accent-primary);
    min-width: 3rem;
}

.processing-status {
    color: var(--text-secondary);
    margin-bottom: var(--spacing-md);
    font-weight: 500;
}

.processing-metrics {
    font-size: 0.875rem;
    color: var(--text-muted);
}

/* Comparison Section */
.comparison-section {
    margin-bottom: var(--spacing-2xl);
}

.comparison-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-xl);
    flex-wrap: wrap;
    gap: var(--spacing-md);
}

.comparison-header h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
}

.comparison-controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
}

.zoom-controls {
    display: flex;
    gap: var(--spacing-xs);
    background: var(--bg-tertiary);
    border-radius: var(--radius-md);
    padding: var(--spacing-xs);
}

.zoom-btn {
    padding: var(--spacing-xs) var(--spacing-md);
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-weight: 500;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
    font-size: 0.875rem;
}

.zoom-btn:hover {
    color: var(--text-primary);
    background: var(--bg-card);
}

.zoom-btn.active {
    background: var(--accent-primary);
    color: white;
}

.download-btn {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--gradient-primary);
    border: none;
    border-radius: var(--radius-md);
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-md);
}

.download-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-lg);
}

/* Image Comparison */
.comparison-container {
    margin-bottom: var(--spacing-xl);
}

.image-comparison {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    min-height: 400px;
    display: flex;
}

.image-container {
    flex: 1;
    position: relative;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-tertiary);
}

.image-container canvas {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
    border-radius: var(--radius-sm);
}

.image-label {
    position: absolute;
    top: var(--spacing-md);
    left: var(--spacing-md);
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    backdrop-filter: blur(10px);
}

.comparison-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    background: var(--accent-primary);
    cursor: col-resize;
    transform: translateX(-50%);
    z-index: 10;
}

.divider-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 24px;
    background: var(--accent-primary);
    border: 2px solid white;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: var(--shadow-md);
}

.divider-handle::before,
.divider-handle::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 6px;
    height: 2px;
    background: white;
    transform: translateY(-50%);
}

.divider-handle::before {
    left: 4px;
}

.divider-handle::after {
    right: 4px;
}

/* Results Info */
.results-info {
    margin-bottom: var(--spacing-xl);
}

.info-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--spacing-xl);
    box-shadow: var(--shadow-md);
}

.info-card h4 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
    color: var(--text-primary);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
}

.stat-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md);
    background: var(--bg-tertiary);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
}

.stat-label {
    color: var(--text-secondary);
    font-weight: 500;
}

.stat-value {
    color: var(--text-primary);
    font-weight: 600;
}

/* Action Buttons */
.action-buttons {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
}

.primary-btn,
.secondary-btn {
    padding: var(--spacing-md) var(--spacing-xl);
    border-radius: var(--radius-md);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    border: none;
    font-size: 1rem;
}

.primary-btn {
    background: var(--gradient-primary);
    color: white;
    box-shadow: var(--shadow-md);
}

.primary-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-lg);
}

.secondary-btn {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

.secondary-btn:hover {
    background: var(--bg-card);
    border-color: var(--accent-primary);
}

/* Footer */
.app-footer {
    padding: var(--spacing-xl) var(--spacing-lg);
    text-align: center;
    border-top: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-secondary);
}

.footer-content {
    max-width: 1200px;
    margin: 0 auto;
}

.performance-info {
    margin-top: var(--spacing-md);
    font-size: 0.875rem;
    color: var(--text-muted);
}

/* Modal */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    backdrop-filter: blur(4px);
}

.modal {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    max-width: 500px;
    width: 90%;
    max-height: 80vh;
    overflow: auto;
    box-shadow: var(--shadow-xl);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-xl);
    border-bottom: 1px solid var(--border-color);
}

.modal-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
}

.modal-close {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.5rem;
    cursor: pointer;
    padding: var(--spacing-xs);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
}

.modal-close:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
}

.modal-body {
    padding: var(--spacing-xl);
    color: var(--text-secondary);
    line-height: 1.6;
}

.modal-footer {
    padding: var(--spacing-xl);
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-md);
}

/* Responsive Design */
@media (max-width: 1024px) {
    .results-comparison {
        grid-template-columns: 1fr;
        gap: var(--spacing-xl);
    }
    
    .upscaled-panel {
        order: -1;
    }
}

@media (max-width: 768px) {
    .app-title {
        font-size: 2rem;
    }
    
    .app-subtitle {
        font-size: 1rem;
    }
    
    .main-content {
        padding: var(--spacing-lg);
    }
    
    .upload-area-prominent {
        min-width: auto;
        padding: var(--spacing-xl);
    }
    
    .upload-area-prominent h2 {
        font-size: 1.5rem;
    }
    
    .scale-buttons {
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-md);
    }
    
    .upload-hints {
        flex-direction: column;
        gap: var(--spacing-sm);
    }
    
    .results-header {
        flex-direction: column;
        gap: var(--spacing-md);
        align-items: stretch;
    }
    
    .action-buttons {
        flex-direction: column;
    }
    
    .comparison-header {
        flex-direction: column;
        align-items: stretch;
    }
    
    .comparison-controls {
        justify-content: center;
    }
    
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .image-comparison {
        flex-direction: column;
        min-height: 600px;
    }
    
    .comparison-divider {
        top: 50%;
        left: 0;
        right: 0;
        width: 100%;
        height: 4px;
        cursor: row-resize;
    }
}

@media (max-width: 480px) {
    .app-header {
        padding: var(--spacing-lg);
    }
    
    .model-info {
        flex-direction: column;
        gap: var(--spacing-sm);
    }
    
    .scale-buttons {
        grid-template-columns: 1fr;
    }
    
    .zoom-controls {
        width: 100%;
        justify-content: center;
    }
    
    .download-btn {
        width: 100%;
        justify-content: center;
    }
}

/* Animations */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.fade-in {
    animation: fadeIn 0.5s ease-out;
}

/* Loading States */
.loading {
    position: relative;
    overflow: hidden;
}

.loading::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    animation: loading-shimmer 1.5s infinite;
}

@keyframes loading-shimmer {
    0% { left: -100%; }
    100% { left: 100%; }
}

/* Optimized UI Components */
.loading-spinner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
}

.spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border-color);
    border-top: 3px solid var(--accent-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.status-display {
    text-align: center;
    padding: var(--spacing-md);
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.results-container {
    padding: var(--spacing-xl);
}

.comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    max-width: 1200px;
    margin: 0 auto;
}

.image-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    text-align: center;
}

.image-panel h3 {
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
}

.image-panel canvas {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
}

.image-panel button {
    margin-top: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--gradient-primary);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.image-panel button:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
}

/* Responsive Design for Optimized UI */
@media (max-width: 768px) {
    .comparison {
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
    }
    
    .progress-header {
        flex-direction: column;
        gap: var(--spacing-sm);
    }
}

/* Utility Classes */
.hidden {
    display: none !important;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
} 